SERVER_NAME=ContextBridge MCP Server
SERVER_VERSION=2.0.0
ENVIRONMENT=development

# MCP auth gate: api_key | oauth2 | both
MCP_AUTH_MODE=oauth2

# Bearer token backend: demo | oidc
AUTH_BACKEND=oidc

# Optional API key mode (use only when MCP_AUTH_MODE includes api_key)
MCP_API_KEY=change-me-demo-key

# Enterprise OIDC settings
OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_AUDIENCE=api://<app-id-uri>
# OIDC_JWKS_URL is optional; if empty it is derived from issuer URL.
OIDC_JWKS_URL=

# Demo fallback token issuer settings (only used when AUTH_BACKEND=demo)
MCP_OAUTH_CLIENT_ID=demo-client
MCP_OAUTH_CLIENT_SECRET=change-me-demo-secret
MCP_OAUTH_CLIENTS=person1:person1-secret,person2:person2-secret
MCP_OAUTH_TOKEN_TTL_SECONDS=3600
MCP_OAUTH_ALLOWED_SCOPES=mcp:initialize mcp:tools:list mcp:tools:call mcp:tools:call:greet_user mcp:tools:call:calculate mcp:tools:call:get_weather mcp:tools:call:reverse_string mcp:tools:call:url_health_check
MCP_OAUTH_DEFAULT_SCOPES=mcp:initialize mcp:tools:list
